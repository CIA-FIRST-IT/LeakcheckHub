# Copy to .env and replace every value. Do not commit .env.
LC_ENVIRONMENT=development
LC_DATABASE_URL=postgresql+asyncpg://leakcheck_runtime:replace-with-a-long-random-password@postgres:5432/leakcheck
LC_SESSION_SECRET=replace-with-at-least-32-random-characters
# Local super-admin throttles. Defaults are 5 account failures/15 min and 10 IP failures/15 min.
LC_ADMIN_LOGIN_MAX_FAILURES=5
LC_ADMIN_LOGIN_LOCKOUT_SECONDS=900
LC_ADMIN_LOGIN_IP_MAX_FAILURES=10
LC_ADMIN_LOGIN_IP_WINDOW_SECONDS=900
LC_ADMIN_LOGIN_IP_LOCKOUT_SECONDS=900
# Bootstrap-only root key: encrypts integration secrets held in PostgreSQL. It cannot itself live in
# PostgreSQL. Use a deployment secret manager in production; never expose it in the settings page.
# 32 random bytes, base64-url encoded.
LC_DATA_KEY=replace-with-a-base64url-encoded-32-byte-key
LC_TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Used only by `docker compose` / Alembic's first bootstrap migration.
LC_POSTGRES_PASSWORD=replace-with-a-long-random-password
LC_MIGRATOR_DB_PASSWORD=replace-with-a-long-random-password
LC_RUNTIME_DB_PASSWORD=replace-with-a-long-random-password

# LeakCheck, Google, Wazuh, DFIR-IRIS, SMTP, SOC mail, and user/role configuration are intentionally
# absent here. A fresh deployment starts blank; configure them at /admin/settings after bootstrap.
